#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>

/* Confirm these profile numbers before flashing. ZMK profiles are 0-indexed. */
#define LAPTOP_SLOT 0
#define PHONE_SLOT 1
#define BASE_LAYER 0
#define IPHONE_LAYER 3
#define HOST_SWITCH_WAIT_MS 10
#define HOST_SWITCH_TAP_MS 10
#define IPHONE_HANDOFF_WAIT_MS 300
#define LAPTOP_RECONNECT_WAIT_MS 1500

/ {
    macros {
        to_iphone: to_iphone {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <HOST_SWITCH_WAIT_MS>;
            tap-ms = <HOST_SWITCH_TAP_MS>;
            /* macro_wait_time applies after subsequent behaviors. */
            bindings = <&macro_wait_time IPHONE_HANDOFF_WAIT_MS>
                     , <&kp LS(LC(LA(LG(T))))>
                     , <&macro_wait_time HOST_SWITCH_WAIT_MS>
                     , <&bt BT_SEL PHONE_SLOT>
                     , <&to IPHONE_LAYER>;
        };

        to_laptop: to_laptop {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <HOST_SWITCH_WAIT_MS>;
            tap-ms = <HOST_SWITCH_TAP_MS>;
            /* The reconnect wait is attached to BT_SEL before the hotkey. */
            bindings = <&macro_wait_time LAPTOP_RECONNECT_WAIT_MS>
                     , <&bt BT_SEL LAPTOP_SLOT>
                     , <&macro_wait_time HOST_SWITCH_WAIT_MS>
                     , <&kp LC(LA(LG(T)))>
                     , <&to BASE_LAYER>;
        };

        gui_up_macro: gui_up_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>
                     , <&macro_tap &kp UP>
                     , <&macro_release &kp LGUI>;
        };

        gui_down_macro: gui_down_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>
                     , <&macro_tap &kp DOWN>
                     , <&macro_release &kp LGUI>;
        };

        half_down: half_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_tap &kp DOWN &kp DOWN &kp DOWN &kp DOWN &kp DOWN &kp DOWN &kp DOWN &kp DOWN>;
        };

        half_up: half_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&macro_tap &kp UP &kp UP &kp UP &kp UP &kp UP &kp UP &kp UP &kp UP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp Q  &kp W  &kp F      &kp P     &kp B          &kp J        &kp L    &kp U      &kp Y    &kp SEMI  &kp MINUS
&kp BSPC   &kp A  &kp R  &kp S      &kp T     &kp G          &kp M        &kp N    &kp E      &kp I    &kp O     &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C      &kp D     &kp V          &kp K        &kp H    &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                         &kp LCTRL  &kp LGUI  &lt 1 SPACE    &lt 2 SPACE  &kp RET  &kp ESC
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp EQUAL  &kp N1    &kp N2  &kp N3          &kp N4      &kp N5       &kp N6     &kp N7    &kp N8        &trans                &trans                 &kp MINUS
&trans     &kp EXCL  &kp AT  &kp HASH        &kp DOLLAR  &kp PRCNT    &kp CARET  &kp AMPS  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSLASH
&kp LSHFT  &trans    &trans  &kp LEFT_ARROW  &kp RIGHT   &trans       &kp GRAVE  &kp DOWN  &kp UP_ARROW  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans
                             &trans          &trans      &trans       &trans     &trans    &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            // Hold the RSE thumb key, then press Z for iPhone or X for laptop.
            bindings = <
&kp DEL    &kp EXCL      &kp AT           &kp HASH        &kp DLLR   &kp PRCNT    &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR         &kp RPAR   &kp BSPC
&kp LCTRL  &kp NUMBER_1  &kp KP_NUMBER_2  &kp KP_N3       &kp KP_N4  &kp KP_N5    &kp KP_N6  &kp KP_N7  &kp KP_N8        &kp KP_NUMBER_9  &kp KP_N0  &kp GRAVE
&kp LSHFT  &to_iphone   &to_laptop       &trans          &trans     &trans       &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC         &kp PIPE   &trans
                                          &bt BT_CLR_ALL  &trans       &trans     &trans     &trans     &kp RALT
            >;
        };

        iphone_layer {
            // Transparent fallback preserves the laptop layout; the outer R thumb holds NAV.
            bindings = <
&trans      &trans      &trans      &trans      &trans      &trans       &trans      &trans      &trans      &trans      &trans      &trans
&trans      &trans      &trans      &trans      &trans      &trans       &trans      &trans      &trans      &trans      &trans      &trans
&trans      &trans      &trans      &trans      &trans      &trans       &trans      &trans      &trans      &trans      &trans      &trans
                         &trans      &trans      &trans       &trans      &trans      &mo NAV
            >;
        };

        nav_layer {
            // These positions follow the existing Colemak-DH key bindings, not the stale layout comments.
            bindings = <
&trans      &trans      &trans      &half_down  &trans      &half_up     &kp DOWN   &kp RIGHT  &kp PG_UP  &trans      &trans      &trans
&trans      &trans      &trans      &trans      &trans      &gui_up_macro &gui_down_macro &trans    &trans      &trans      &trans      &trans
&trans      &trans      &trans      &trans      &kp PG_DN   &trans       &kp UP     &kp LEFT   &trans      &trans      &trans      &trans
                         &trans      &trans      &trans       &trans      &trans      &trans
            >;
        };
    };
};
